				"header": [
					{ "key": "Authorization", "value": "Bearer {{tokenAdmin}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"codigo\": \"SRV-009\",\n  \"nombre\": \"Revisión y Limpieza de Frenos ABS\",\n  \"precio\": 110.00,\n  \"duracionMin\": 45,\n  \"activo\": true\n}"
