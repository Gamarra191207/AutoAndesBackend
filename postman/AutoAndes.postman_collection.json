{
	"info": {
		"_postman_id": "autoandes-api-collection-2026",
		"name": "AutoAndes API REST - Examen Parcial II",
		"description": "Colección completa de pruebas para AutoAndes API con casos 200/201, 400, 401, 403, 404 y 409",
